                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find libertech_hand_description)/meshes/f11.STL" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}hand_right_f11_joint" type="revolute">
            <origin xyz="-0.022466 0.027654 0.043657" rpy="1.5708 0.02618 1.5708" />
            <parent link="${prefix}hand_right_palm" />
            <child link="${prefix}hand_right_f11" />
            <axis xyz="0 0 -1" />
