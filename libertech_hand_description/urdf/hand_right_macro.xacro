<?xml version="1.0"?>
<robot name="hand_right"
    xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="load_hand" params=" prefix:='' connected_to:='' xyz:='0 0 0' rpy:='0 0 0' use_fake_hardware:=false sim_ignition:=false">
        <xacro:unless value="${not connected_to}">
            <joint name="${prefix}${connected_to}_hand_right_joint" type="fixed">
                <parent link="${connected_to}"/>
                <child link="${prefix}hand_right_palm"/>
                <origin rpy="${rpy}" xyz="${xyz}"/>

            </joint>
        </xacro:unless>

        <xacro:include filename="$(find libertech_hand_description)/urdf/hand.ros2_control.xacro" />
        <xacro:arg name="initial_positions_file" default="$(find libertech_hand_description)/config/initial_positions.yaml"/>
        <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

        <xacro:hand_ros2_control prefix="${prefix}" name="hand_right" use_fake_hardware="${use_fake_hardware}" sim_ignition="${sim_ignition}"/>
        <!-- initial_positions="${xacro.load_yaml(initial_positions_file)}"  -->

        <link name="${prefix}hand_right_palm">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.91778" />
                <inertia ixx="0.0018592" ixy="6.239E-05" ixz="-6.688E-05" iyy="0.0015814" iyz="3.163E-05" izz="0.00064901" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find libertech_hand_description)/meshes/palm.STL" />
                </geometry>
                <material name="">
                    <color rgba="0.2 0.2 0.2 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find libertech_hand_description)/meshes/palm.STL" />
                </geometry>
            </collision>
        </link>
        <link name="${prefix}hand_right_f11">
            <inertial>
                <origin xyz="0 0.00069742 -0.0093798" rpy="0 0 0" />
                <mass value="0.0033015" />
