<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="freeman_without_arm">

    <!-- simplified collision value -->
    <xacro:property name="head_width" value="0.09"/>
    <xacro:property name="head_length" value="0.18"/>
    <xacro:property name="head_height" value="0.14"/>

    <xacro:property name="trunk_width" value="0.3"/>
    <xacro:property name="trunk_length" value="0.3504"/>
    <xacro:property name="trunk_height" value="0.14"/>

    <xacro:property name="breastplate_width" value="0.3"/>
    <xacro:property name="breastplate_length" value="0.3504"/>
    <xacro:property name="breastplate_height" value="0.14"/>
    
    <xacro:property name="pelvis_width" value="0.18"/>
    <xacro:property name="pelvis_length" value="0.25"/>
    <xacro:property name="pelvis_height" value="0.14"/>

    <xacro:property name="hip_radius" value="0.046"/>
    <xacro:property name="hip_length" value="0.04"/>

    <xacro:property name="thigh_shoulder_radius" value="0.032"/>
    <xacro:property name="thigh_shoulder_length" value="0.041"/>
    <xacro:property name="thigh_length" value="0.048"/>
    <xacro:property name="thigh_width" value="0.048"/>
    <xacro:property name="thigh_height" value="0.032"/>

    <xacro:property name="shank_width"  value="0.02"/>
    <xacro:property name="shank_length" value="0.03"/>
    <xacro:property name="shank_height" value="0.045"/>
    <xacro:property name="shank_radius" value="0.029"/>
    <xacro:property name="shank_thickness" value="0.03"/>

    <xacro:property name="foot_length"   value="0.21"/>
    <xacro:property name="foot_radius" value="0.02"/>

    <!-- joint limits -->
    <xacro:property name="hip_actuator_damping" value="0.0"/>
    <xacro:property name="hip_actuator_friction" value="0.0"/>

    <xacro:property name="thigh_actuator_damping" value="0.0"/>
    <xacro:property name="thigh_actuator_friction" value="0.0"/>

    <xacro:property name="knee_actuator_damping" value="0.0"/>
    <xacro:property name="knee_actuator_friction" value="0.0"/>

    <xacro:property name="ankle_actuator_damping" value="0.0"/>
    <xacro:property name="ankle_actuator_friction" value="0.0"/>

    <xacro:property name="waist_yaw_max" value="${60*pi/180.0}"/>
    <xacro:property name="waist_yaw_min" value="${-60*pi/180.0}"/>
    <xacro:property name="waist_yaw_velocity_max" value="${180*2*pi/60}"/>
    <xacro:property name="waist_yaw_torque_max" value="60"/>

    <xacro:property name="HTAA_max" value="${45*pi/180.0}"/>
    <xacro:property name="HTAA_min" value="${-60*pi/180.0}"/>
    <xacro:property name="HTAA_velocity_max" value="${180*2*pi/60}"/>
    <xacro:property name="HTAA_torque_max" value="60"/>

    <xacro:property name="HAA_max" value="${45*pi/180.0}"/>
    <xacro:property name="HAA_min" value="${-60*pi/180.0}"/>
    <xacro:property name="HAA_velocity_max" value="${180*2*pi/60}"/>
    <xacro:property name="HAA_torque_max" value="60"/>

    <xacro:property name="HFE_max" value="${80*pi/180.0}"/>
    <xacro:property name="HFE_min" value="${-120*pi/180.0}"/>
    <xacro:property name="HFE_velocity_max" value="${120*2*pi/60}"/>
    <xacro:property name="HFE_torque_max" value="150"/>

    <xacro:property name="KFE_max" value="${120*pi/180.0}"/>
    <xacro:property name="KFE_min" value="${0*pi/180.0}"/>
    <xacro:property name="KFE_velocity_max" value="${100*2*pi/60}"/>
    <xacro:property name="KFE_torque_max" value="230"/>

    <xacro:property name="AFE_max" value="${60*pi/180.0}"/>
    <xacro:property name="AFE_min" value="${-60*pi/180.0}"/>
    <xacro:property name="AFE_velocity_max" value="${200*2*pi/60}"/>
    <xacro:property name="AFE_torque_max" value="50"/>


</robot>
