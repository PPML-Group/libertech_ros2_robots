<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <xacro:arg name="prefix"  default="" />
    <xacro:arg name="use_hand" default="false" />
    <xacro:arg name="use_gripper" default="false" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="use_camera" default="true" /> 
    <xacro:arg name="camera_width" default="640"/>
    <xacro:arg name="camera_height" default="480"/>
    <xacro:arg name="camera_fps" default="30"/>
    <xacro:arg name="simulation_controllers" default="$(find libertech_humanoid_description)/config/ros2_controllers.yaml" />

    <xacro:include filename="$(find libertech_humanoid_description)/urdf/const.xacro"/>
    <xacro:include filename="$(find libertech_humanoid_description)/urdf/materials.xacro"/>
    <xacro:include filename="$(find libertech_humanoid_description)/urdf/imu_macro.xacro"/>
    <xacro:include filename="$(find libertech_humanoid_description)/urdf/head_macro.xacro"/>
    <xacro:include filename="$(find libertech_humanoid_description)/urdf/leg_macro.xacro"/>
    <xacro:include filename="$(find libertech_arm_description)/urdf/arm_hand_macro.xacro"/>

    <xacro:property name="mesh_path" value="file://$(find libertech_humanoid_description)/meshes/"/>

    <!-- 如果取消world则为漂浮 -->
    <link name="world"/>

    <joint name="$(arg prefix)base_static_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="world"/>
        <child link="$(arg prefix)base"/>
    </joint>

    <link name="$(arg prefix)base">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_path}/trunk.STL" scale="1 1 1"/>
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
            </geometry>
        </collision>
        <inertial>
          <origin
            xyz="-0.024598 0.0055905 0.18286"
            rpy="0 0 0" />
          <mass value="10" />
          <inertia ixx="0.049009" ixy="-2.629E-05" ixz="-0.00018492"
                   iyy="0.037036" iyz="0.00056345"
                   izz="0.021052" />
        </inertial>
    </link>

    <joint
        name="$(arg prefix)base_to_breastplate_fixed"
        type="fixed">
        <origin
          xyz="0.136 0 0.21656"
          rpy="0 1.5708 0" />
        <parent link="$(arg prefix)base" />
        <child link="$(arg prefix)breastplate" />
      </joint>

    <link
        name="$(arg prefix)breastplate">
        <inertial>
          <origin
            xyz="-0.000867 3.424E-05 -0.005697"
            rpy="0 0 0" />
          <mass
            value="0.85" />
          <inertia ixx="0.012172" ixy="8.0504E-07" ixz="-9.2127E-05"
                   iyy="0.003647" iyz="5.8738E-07"
                   izz="0.013851" />
        </inertial>
        <visual>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_path}/breastplate.STL" />
          </geometry>
          <material name="grey" />
        </visual>
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <box size="${breastplate_width} ${breastplate_length} ${breastplate_height}" />
          </geometry>
        </collision>
      </link>

      <joint name="$(arg prefix)base_to_battery_fixed" type="fixed">
        <origin
          xyz="-0.108500000000001 4.2820323028811E-05 0.196560294979676"
          rpy="0 0 0" />
        <parent link="$(arg prefix)base" />
        <child link="$(arg prefix)battery" />
      </joint>

      <link name="$(arg prefix)battery">
        <inertial>
          <origin
            xyz="-0.00021714 -5.6877E-08 -0.00033886"
            rpy="0 0 0" />
          <mass value="10.346" />
          <inertia ixx="0.10449" ixy="1.6722E-08" ixz="4.2923E-05"
                   iyy="0.06951" iyz="-1.7277E-08"
                   izz="0.04501" />
        </inertial>
        <visual>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_path}/battery.STL" />
          </geometry>
          <material name="silver"/>
        </visual>
      </link>
      
      <joint name="$(arg prefix)base_to_waist_fixed" type="fixed">
        <origin
          xyz="0 0 -0.0176"
          rpy="0 0 0" />
        <parent link="$(arg prefix)base" />
        <child link="$(arg prefix)waist_actuator" />
      </joint>

      <link name="$(arg prefix)waist_actuator">
        <inertial>
          <origin
            xyz="-0.000186850869182693 -9.1956687663694E-05 0.0291785584254683"
            rpy="0 0 0" />
          <mass value="1.1" />
          <inertia ixx="0.000705" ixy="-2.07140E-06" ixz="-8.785568E-08"
                   iyy="0.000714" iyz="1.485556E-07"
                   izz="0.001342" />
        </inertial>
        <visual>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_path}/waist_actuator.STL" />
          </geometry>
          <material name="silver" />
        </visual>
      </link>

      <joint name="$(arg prefix)waist_yaw_joint" type="revolute">
          <origin xyz="0 0 0" rpy="3.1415926 0 0" />
          <parent link="$(arg prefix)waist_actuator" />
          <child  link="$(arg prefix)pelvis" />
          <axis xyz="0 0 1" />
          <limit lower="${waist_yaw_min}" upper="${waist_yaw_max}"
                 effort="${waist_yaw_torque_max}"  velocity="${waist_yaw_velocity_max}" />
      </joint>

      <link name="$(arg prefix)pelvis">
          <inertial>
            <origin
              xyz="-0.035353 2.077E-05 0.059170"
              rpy="0 0 0" />
            <mass value="2.5" />
            <inertia ixx="0.014239" ixy="1.7481E-07" ixz="0.001616"
                     iyy="0.007796" iyz="-2.306E-07"
                     izz="0.014610" />
          </inertial>
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
              <mesh filename="${mesh_path}/pelvis.STL" />
            </geometry>
            <material name="orange" />
          </visual>
          <collision>
            <origin
              xyz="0 0 0"
              rpy="0 0 0" />
            <geometry>
              <box size="${pelvis_length} ${pelvis_width} ${pelvis_height}"/>
            </geometry>
          </collision>
        </link>

    <xacro:load_head
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)base"  
        xyz="0.035 0 0.336" 
        rpy="0. 0. 0."
        use_camera="$(arg use_camera)"/>

    <xacro:load_imu 
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)base"  
        xyz="0. 0. 0." 
        rpy="0. 0. 0."
        imu_name="base_imu" />

    <xacro:load_leg
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)pelvis"
        mirror="false" >
          <origin rpy="0 -0.349066 0" xyz="-0.024112 0.066 0.110009"/>
    </xacro:load_leg>

    <xacro:load_leg
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)pelvis"
        mirror="true" >
        <origin rpy="0 -0.349066 0" xyz="-0.024112 -0.066 0.110009"/>
    </xacro:load_leg>

    <xacro:load_arm_hand
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)base" 
        xyz="0 -0.17735 0.35582"
        rpy="1.309 0 0"
        arm="arm_right"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)" />

    <xacro:load_arm_hand
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)base" 
        xyz="0 0.177350 0.355816"
        rpy="-1.308997 0 0"
        arm="arm_left"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)" />

    <!-- ###################################################################################### -->
    <xacro:include filename="$(find libertech_humanoid_description)/urdf/head.ros2_control.xacro" />
    <xacro:arg name="initial_positions_file_head" default="$(find libertech_humanoid_description)/config/initial_positions_head.yaml"/>
    <xacro:property name="initial_positions_file_head" default="$(arg initial_positions_file_head)"/>
    <xacro:head_ros2_control
        prefix="$(arg prefix)"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        initial_positions="${xacro.load_yaml(initial_positions_file_head)}" />

    <xacro:include filename="$(find libertech_arm_description)/urdf/arm.ros2_control.xacro" />
    <xacro:arg name="initial_positions_file_arm" default="$(find libertech_arm_description)/config/initial_positions_arm.yaml"/>
    <xacro:property name="initial_positions_file_arm" default="$(arg initial_positions_file_arm)"/>
    <xacro:arm_ros2_control
        prefix="$(arg prefix)"
        use_right="True"
        use_left="True"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        initial_positions="${xacro.load_yaml(initial_positions_file_arm)}" />

    <xacro:if value="$(arg use_hand)">
        <xacro:include filename="$(find libertech_hand_description)/urdf/hand.ros2_control.xacro" />
        <xacro:hand_ros2_control 
            prefix="$(arg prefix)"
            use_right="True"
            use_left="True"
            use_fake_hardware="$(arg use_fake_hardware)"
            sim_ignition="$(arg sim_ignition)"/>
    </xacro:if>

    <xacro:include filename="$(find libertech_humanoid_description)/urdf/leg.ros2_control.xacro" />
    <xacro:arg name="initial_positions_file_leg" default="$(find libertech_humanoid_description)/config/initial_positions_leg.yaml"/>
    <xacro:property name="initial_positions_file_leg" default="$(arg initial_positions_file_leg)"/>
    <xacro:leg_ros2_control
        prefix="$(arg prefix)"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        initial_positions="${xacro.load_yaml(initial_positions_file_leg)}" />    

    <xacro:if value="$(arg sim_ignition)">
        <!-- Gazebo plugins -->
        <gazebo reference="world">
        </gazebo>
        <gazebo>
            <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>$(arg simulation_controllers)</parameters>
                <controller_manager_node_name>/controller_manager</controller_manager_node_name>
            </plugin>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <!-- <render_engine>$(arg gazebo_renderer)</render_engine> -->
                <!-- <render_engine>"ogre"</render_engine> -->
            </plugin>
            <plugin filename="ignition-gazebo-forcetorque-system" name="ignition::gazebo::systems::ForceTorque">
            </plugin>

        </gazebo>
    </xacro:if>
</robot>