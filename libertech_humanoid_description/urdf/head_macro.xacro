<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="head">

    <xacro:macro name="load_head" params="
        prefix:='' 
        connected_to:=''
        xyz:='0 0 0' 
        rpy:='0 0 0'
        use_camera:=True">
        <!-- head_base is fixed to the base link -->

        <joint
            name="${connected_to}_to_head_fixed"  type="fixed">
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <parent link="${connected_to}"/>
            <child link="${prefix}head_yaw" />
        </joint>

        <link name="${prefix}head_yaw">
            <inertial>
                <origin
                    xyz="-0.011285891882378 1.09617695197295E-06 -0.0312296609606463"
                    rpy="0 0 0" />
                <mass value="0.460000078827113" />
                <inertia
                    ixx="0.000479"
                    ixy="6.05596E-08"
                    ixz="3.15012E-08"
                    iyy="0.000200"
                    iyz="-5.2713E-12"
                    izz="0.000611" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head_yaw.STL" />
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head_yaw.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}head_yaw_joint" type="revolute">
            <origin  xyz="0 0 0" rpy="0 0 0" />
            <parent link="${prefix}head_yaw" />
            <child  link="${prefix}head_pitch" />
            <axis  xyz="0 0 1" />
            <limit
            lower="${-pi/2}"
            upper="${pi/2}"
            effort="10"
            velocity="3.14" />
        </joint>

        <link name="${prefix}head_pitch">
            <inertial>
                <origin
                    xyz="8.5974E-07 0.00056985 0.034522"
                    rpy="0 0 0" />
                <mass value="0.36" />
                <inertia
                    ixx="0.00011043"
                    ixy="2.1829E-10"
                    ixz="5.711E-08"
                    iyy="0.00013477"
                    iyz="-2.2161E-06"
                    izz="0.00011092" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head_pitch.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head_pitch.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}head_pitch_joint" type="revolute">
            <origin
            xyz="0 0 0.038"
            rpy="-1.5708 0 0" />
            <parent link="${prefix}head_pitch" />
            <child  link="${prefix}head" />
            <axis xyz="0 0 -1" />
            <limit
                lower="-1"
                upper="1"
                effort="10"
                velocity="3.14" />
        </joint>

        <link  name="${prefix}head">
            <inertial>
                <origin
                    xyz="0.0154730711433543 -0.0794210361159384 0.00173387502254833"
                    rpy="0 0 0" />
                <mass value="0.450014140265304" />
                <inertia
                    ixx="0.00164440833251331"
                    ixy="-6.52605251497062E-05"
                    ixz="1.8986879201475E-06"
                    iyy="0.00150474591559332"
                    iyz="1.43185727033129E-06"
                    izz="0.00139459077195447" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head.STL" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/head.STL" />
                </geometry>
            </collision>
        </link>

        <xacro:if value="${use_camera}">
            <link name="${prefix}head_camera_zedm" />
            <joint name="${prefix}head_camera_zedm_joint" type="fixed">
                <origin xyz="0.03 -0.08 0.0" rpy="${pi/2} 0 0.2" />
                <parent link="${prefix}head" />
                <child  link="${prefix}head_camera_zedm" />
            </joint>

            <link name="${prefix}head_camera_zedm_optical_frame"/>
            <joint name="${prefix}head_camera_zedm_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
                <parent link="${prefix}head_camera_zedm"/>
                <child link="${prefix}head_camera_zedm_optical_frame"/>
            </joint>

            <gazebo reference="${prefix}head_camera_zedm">
                <sensor name="zedm" type="rgbd_camera">  <!-- realsense_d435 -->
                    <camera>
                        <horizontal_fov>1.047</horizontal_fov>
                        <image>
                            <width>$(arg camera_width)</width>
                            <height>$(arg camera_height)</height>
                            <format>R8G8B8</format> <!-- RGB_INT8 -->
                            
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>5</far>
                        </clip>
                        <distortion>
                            <k1>0.0</k1>
                            <k2>0.0</k2>
                            <k3>0.0</k3>
                            <p1>0.0</p1>
                            <p2>0.0</p2>
                            <center>0.5 0.5</center>
                        </distortion>
                        <lens>
                            <intrinsics>
                                <fx>554.25469</fx> <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
                                <fy>554.25469</fy>
                                <cx>320.5</cx> <!-- cx = ( width + 1 ) / 2 -->
                                <cy>240.5</cy> <!-- cy = ( height + 1 ) / 2 -->
                                <s>0</s>
                            </intrinsics>
                            <!-- These need to match the intrinsics above or
                            Ignition will default to different default values -->
                            <projection>
                                <p_fx>554.25469</p_fx>
                                <p_fy>554.25469</p_fy>
                                <p_cx>320.5</p_cx>
                                <p_cy>240.5</p_cy>
                                <tx>0</tx>
                                <ty>0</ty>
                            </projection>
                        </lens>
                        <noise>
                            <type>gaussian</type>
                            <mean>0</mean>
                            <stddev>0.07</stddev>
                        </noise>
                        <depth_camera>
                            <clip>
                            <near>0.25</near>
                            <far>5</far>
                            </clip>
                        </depth_camera>
                        <!-- <optical_frame_id>$(arg prefix)$(arg camera_name)_camera_center_optical_frame</optical_frame_id> -->
                    </camera>
                    <!-- <ignition_frame_id>$(arg prefix)$(arg camera_name)_camera_center_optical_frame</ignition_frame_id> -->
                    <always_on>1</always_on>
                    <update_rate>$(arg camera_fps)</update_rate>
                    <visualize>true</visualize>
                    <topic>zedm</topic>
                    <enable_metrics>false</enable_metrics>
                </sensor>
            </gazebo>

        </xacro:if>

    </xacro:macro>
</robot>