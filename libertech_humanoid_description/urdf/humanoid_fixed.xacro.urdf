    <sensor name="zedm" type="rgbd_camera">
      <!-- realsense_d435 -->
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
          <!-- RGB_INT8 -->
