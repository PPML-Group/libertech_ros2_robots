        <clip>
          <near>0.1</near>
          <far>5</far>
        </clip>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <lens>
          <intrinsics>
            <fx>554.25469</fx>
            <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
            <fy>554.25469</fy>
            <cx>320.5</cx>
            <!-- cx = ( width + 1 ) / 2 -->
            <cy>240.5</cy>
            <!-- cy = ( height + 1 ) / 2 -->
            <s>0</s>
