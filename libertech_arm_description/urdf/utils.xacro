<?xml version="1.0"?>
<!-- 该文件包含了右臂和左臂的macro函数 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="set_link_ignition" params="link">
        <gazebo reference="${link}">
            <collision>
                <max_contacts>10</max_contacts>
                <surface>
                    <friction>
                        <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                        <kp>10000000.0</kp>
                        <kd>1.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.1</max_vel>
                        </ode>
                    </contact>
                </surface>
            </collision>
            <turnGravityOff>false</turnGravityOff>
        </gazebo>
    </xacro:macro>

</robot>