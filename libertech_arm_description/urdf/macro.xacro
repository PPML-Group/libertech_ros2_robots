            </collision>
        </link>
        <joint
            name="j3"
            type="revolute">
            <origin
            xyz="0.0405 -0.1135 0"
            rpy="1.5708 0 0" />
            <parent
            link="joint-2" />
            <child
            link="joint-3" />
            <axis
