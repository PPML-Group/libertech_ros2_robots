<?xml version="1.0"?>
<!-- 该文件包含了右臂和左臂的macro函数 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find libertech_arm_description)/urdf/const.xacro"/>
    
    <xacro:macro name="load_arm_right" params="
        prefix:='' 
        connected_to:='' 
        xyz:='0 0 0' 
        rpy:='0 0 0'" >
        <xacro:unless value="${not connected_to}">
            <joint name="${prefix}${connected_to}_joint" type="fixed">
                <parent link="${connected_to}"/>
                <child link="${prefix}base"/>
                <origin rpy="${rpy}" xyz="${xyz}"/>
            </joint>
        </xacro:unless>

        <link name="${prefix}base">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL"  scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                   <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL" />
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>   
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${base_ComX} ${base_ComY} ${base_ComZ}"/>
                <mass value="${base_Mass}"/>
                <inertia
                    ixx="${base_Ixx}" ixy="${base_Ixy}" ixz="${base_Ixz}"
                    iyy="${base_Iyy}" iyz="${base_Iyz}"
                    izz="${base_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint1" type="revolute">
            <origin rpy="1.5708 0 1.5708" xyz="0.068 0 0"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}link01"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint1_PositionMin}" upper="${joint1_PositionMax}"/>
        </joint>

        <link name="${prefix}link01">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                  <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" />
                </geometry> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L01_ComX} ${L01_ComY} ${L01_ComZ}"/>
                <mass value="${L01_Mass}"/>
                <inertia
                    ixx="${L01_Ixx}" ixy="${L01_Ixy}" ixz="${L01_Ixz}"
                    iyy="${L01_Iyy}" iyz="${L01_Iyz}"
                    izz="${L01_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint2" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0 0 0"/>
            <parent link="${prefix}link01"/>
            <child link="${prefix}link02"/>
            <axis xyz="0 0 -1"/>
            <!-- <dynamics damping="${2*jointDamping}" friction="${2*jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint2_PositionMin}" upper="${joint2_PositionMax}"/>
        </joint>

        <link name="${prefix}link02">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                     <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L02_ComX} ${L02_ComY} ${L02_ComZ}"/>
                <mass value="${L02_Mass}"/>
                <inertia
                    ixx="${L02_Ixx}" ixy="${L02_Ixy}" ixz="${L02_Ixz}"
                    iyy="${L02_Iyy}" iyz="${L02_Iyz}"
                    izz="${L02_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint3" type="revolute">
            <origin rpy="1.5708 0 0" xyz="-0.0405 -0.1135 0"/>
            <parent link="${prefix}link02"/>
            <child link="${prefix}link03"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint3_PositionMin}" upper="${joint3_PositionMax}"/>
        </joint>

        <link name="${prefix}link03">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link3.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link3.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L03_ComX} ${L03_ComY} ${L03_ComZ}"/>
                <mass value="${L03_Mass}"/>
                <inertia
                    ixx="${L03_Ixx}" ixy="${L03_Ixy}" ixz="${L03_Ixz}"
                    iyy="${L03_Iyy}" iyz="${L03_Iyz}"
                    izz="${L03_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint4" type="revolute">
            <origin rpy="-1.5708 0 1.5708" xyz="0 0.053741 0.15856"/> 
            <parent link="${prefix}link03"/>
            <child link="${prefix}link04"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint4_PositionMin}" upper="${joint4_PositionMax}"/>
        </joint>

        <link name="${prefix}link04">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link4.STL"  scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link4.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L04_ComX} ${L04_ComY} ${L04_ComZ}"/>
                <mass value="${L04_Mass}"/>
                <inertia
                    ixx="${L04_Ixx}" ixy="${L04_Ixy}" ixz="${L04_Ixz}"
                    iyy="${L04_Iyy}" iyz="${L04_Iyz}"
                    izz="${L04_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint5" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0.0991 0 9.4529E-05"/>
            <parent link="${prefix}link04"/>
            <child link="${prefix}link05"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint5_PositionMin}" upper="${joint5_PositionMax}"/>
        </joint>

        <link name="${prefix}link05">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link5.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link5.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L05_ComX} ${L05_ComY} ${L05_ComZ}"/>
                <mass value="${L05_Mass}"/>
                <inertia
                    ixx="${L05_Ixx}" ixy="${L05_Ixy}" ixz="${L05_Ixz}"
                    iyy="${L05_Iyy}" iyz="${L05_Iyz}"
                    izz="${L05_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint6" type="revolute">
            <origin rpy="0 -1.5708 0" xyz="9.4529E-05 0 0.038"/>
            <parent link="${prefix}link05"/>
            <child link="${prefix}link06"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>

        <link name="${prefix}link06">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link6.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link6.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L06_ComX} ${L06_ComY} ${L06_ComZ}"/>
                <mass value="${L06_Mass}"/>
                <inertia
                    ixx="${L06_Ixx}" ixy="${L06_Ixy}" ixz="${L06_Ixz}"
                    iyy="${L06_Iyy}" iyz="${L06_Iyz}"
                    izz="${L06_Izz}"/> 
            </inertial>
        </link>

        <joint name="${prefix}joint7" type="revolute">
            <origin rpy="-1.5708 0 0" xyz="0.065 0 9.4629E-05"/>
            <parent link="${prefix}link06"/>
            <child link="${prefix}link07"/>
            <axis xyz="0 0 -1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>
        

        <link name="${prefix}link07">
             <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link7.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link7.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L07_ComX} ${L07_ComY} ${L07_ComZ}"/>
                <mass value="${L07_Mass}"/>
                <inertia
                    ixx="${L07_Ixx}" ixy="${L07_Ixy}" ixz="${L07_Ixz}"
                    iyy="${L07_Iyy}" iyz="${L07_Iyz}"
                    izz="${L07_Izz}"/> 
            </inertial>
        </link>
    </xacro:macro>


    <!-- TODO: 左臂macro -->
    <xacro:macro name="load_arm_left" params="
        prefix:='' 
        connected_to:='' 
        xyz:='0 0 0' 
        rpy:='0 0 0'" >
        <xacro:unless value="${not connected_to}">
            <joint name="${prefix}${connected_to}_joint" type="fixed">
                <parent link="${connected_to}"/>
                <child link="${prefix}base"/>
                <origin rpy="${rpy}" xyz="${xyz}"/>
            </joint>
        </xacro:unless>
       
       <link name="${prefix}base">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL"  scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/base_left.STL"  scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                   <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL" scale="-1 1 1"/> -->
                   <mesh filename="file://$(find libertech_arm_description)/meshes/base_left.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>   
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${-base_ComX} ${base_ComY} ${base_ComZ}"/>
                <mass value="${base_Mass}"/>
                <inertia
                    ixx="${base_Ixx}" ixy="${-base_Ixy}" ixz="${-base_Ixz}"
                    iyy="${base_Iyy}" iyz="${base_Iyz}"
                    izz="${base_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint1" type="revolute">
            <origin rpy="1.5708 0 1.5708" xyz="-0.068 0 0"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}link01"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint1_PositionMin}" upper="${joint1_PositionMax}"/>
        </joint>

        <link name="${prefix}link01">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link1_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link1_left.STL" scale="1 1 1"/>
                </geometry> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L01_ComX} ${L01_ComY} ${-L01_ComZ}"/>
                <mass value="${L01_Mass}"/>
                <inertia
                    ixx="${L01_Ixx}" ixy="${L01_Ixy}" ixz="${-L01_Ixz}"
                    iyy="${L01_Iyy}" iyz="${-L01_Iyz}"
                    izz="${L01_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}joint2" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0 0 0"/>
            <parent link="${prefix}link01"/>
            <child link="${prefix}link02"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${2*jointDamping}" friction="${2*jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint2_PositionMin}" upper="${joint2_PositionMax}"/>
        </joint>

        <link name="${prefix}link02">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link2_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                     <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="-1 1 1"/> -->
                     <mesh filename="file://$(find libertech_arm_description)/meshes/link2_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
