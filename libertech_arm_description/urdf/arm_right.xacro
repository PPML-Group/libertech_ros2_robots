<?xml version="1.0"?>

<robot name="arm_description" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find arm_description)/urdf/arm_constant.xacro"/>
    <!-- <xacro:include filename="$(find arm_description)/urdf/utils.xacro"/> -->
    <!-- <xacro:include filename="$(find arm_description)/urdf/camera.xacro"/> -->

    <xacro:macro name="freearm" params="id:='' connected_to:='' xyz:='0 0 0' rpy:='0 0 0'" >
        <xacro:unless value="${not connected_to}">
            <joint name="${id}${connected_to}_joint" type="fixed">
                <parent link="${connected_to}"/>
                <child link="${id}base"/>
                <origin rpy="${rpy}" xyz="${xyz}"/>
            </joint>
        </xacro:unless>

        <link name="${id}base">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/base.STL"  scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                   <mesh filename="package://libertech_arm_description/meshes/base.STL" />
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>   
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${base_ComX} ${base_ComY} ${base_ComZ}"/>
                <mass value="${base_Mass}"/>
                <inertia
                    ixx="${base_Ixx}" ixy="${base_Ixy}" ixz="${base_Ixz}"
                    iyy="${base_Iyy}" iyz="${base_Iyz}"
                    izz="${base_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint1" type="revolute">
            <origin rpy="1.5708 0 1.5708" xyz="0.068 0 0"/>
            <parent link="${id}base"/>
            <child link="${id}link01"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint1_PositionMin}" upper="${joint1_PositionMax}"/>
        </joint>

        <link name="${id}link01">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-1.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                  <mesh filename="package://libertech_arm_description/meshes/joint-1.STL" />
                </geometry> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L01_ComX} ${L01_ComY} ${L01_ComZ}"/>
                <mass value="${L01_Mass}"/>
                <inertia
                    ixx="${L01_Ixx}" ixy="${L01_Ixy}" ixz="${L01_Ixz}"
                    iyy="${L01_Iyy}" iyz="${L01_Iyz}"
                    izz="${L01_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint2" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0 0 0"/>
            <parent link="${id}link01"/>
            <child link="${id}link02"/>
            <axis xyz="0 0 -1"/>
            <!-- <dynamics damping="${2*jointDamping}" friction="${2*jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint2_PositionMin}" upper="${joint2_PositionMax}"/>
        </joint>

        <link name="${id}link02">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-2.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                     <mesh filename="package://libertech_arm_description/meshes/joint-2.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L02_ComX} ${L02_ComY} ${L02_ComZ}"/>
                <mass value="${L02_Mass}"/>
                <inertia
                    ixx="${L02_Ixx}" ixy="${L02_Ixy}" ixz="${L02_Ixz}"
                    iyy="${L02_Iyy}" iyz="${L02_Iyz}"
                    izz="${L02_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint3" type="revolute">
            <origin rpy="1.5708 0 0" xyz="-0.0405 -0.1135 0"/>
            <parent link="${id}link02"/>
            <child link="${id}link03"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint3_PositionMin}" upper="${joint3_PositionMax}"/>
        </joint>

        <link name="${id}link03">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-3.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-3.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L03_ComX} ${L03_ComY} ${L03_ComZ}"/>
                <mass value="${L03_Mass}"/>
                <inertia
                    ixx="${L03_Ixx}" ixy="${L03_Ixy}" ixz="${L03_Ixz}"
                    iyy="${L03_Iyy}" iyz="${L03_Iyz}"
                    izz="${L03_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint4" type="revolute">
            <origin rpy="-1.5708 0 1.5708" xyz="0 0.053741 0.15856"/> 
            <parent link="${id}link03"/>
            <child link="${id}link04"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint4_PositionMin}" upper="${joint4_PositionMax}"/>
        </joint>

        <link name="${id}link04">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-4.STL"  scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-4.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L04_ComX} ${L04_ComY} ${L04_ComZ}"/>
                <mass value="${L04_Mass}"/>
                <inertia
                    ixx="${L04_Ixx}" ixy="${L04_Ixy}" ixz="${L04_Ixz}"
                    iyy="${L04_Iyy}" iyz="${L04_Iyz}"
                    izz="${L04_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint5" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0.0991 0 9.4529E-05"/>
            <parent link="${id}link04"/>
            <child link="${id}link05"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint5_PositionMin}" upper="${joint5_PositionMax}"/>
        </joint>

        <link name="${id}link05">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-5.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-5.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L05_ComX} ${L05_ComY} ${L05_ComZ}"/>
                <mass value="${L05_Mass}"/>
                <inertia
                    ixx="${L05_Ixx}" ixy="${L05_Ixy}" ixz="${L05_Ixz}"
                    iyy="${L05_Iyy}" iyz="${L05_Iyz}"
                    izz="${L05_Izz}"/>  
            </inertial>
        </link>

        <joint name="${id}joint6" type="revolute">
            <origin rpy="0 -1.5708 0" xyz="9.4529E-05 0 0.038"/>
            <parent link="${id}link05"/>
            <child link="${id}link06"/>
            <axis xyz="0 0 1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>

        <link name="${id}link06">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-6.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-6.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L06_ComX} ${L06_ComY} ${L06_ComZ}"/>
                <mass value="${L06_Mass}"/>
                <inertia
                    ixx="${L06_Ixx}" ixy="${L06_Ixy}" ixz="${L06_Ixz}"
                    iyy="${L06_Iyy}" iyz="${L06_Iyz}"
                    izz="${L06_Izz}"/> 
            </inertial>
        </link>

        <joint name="${id}joint7" type="revolute">
            <origin rpy="-1.5708 0 0" xyz="0.065 0 9.4629E-05"/>
            <parent link="${id}link06"/>
            <child link="${id}link07"/>
            <axis xyz="0 0 -1"/>
            <!-- <dynamics damping="${jointDamping}" friction="${jointFriction}"/> -->
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>
        

        <link name="${id}link07">
             <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-7.STL" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://libertech_arm_description/meshes/joint-7.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L07_ComX} ${L07_ComY} ${L07_ComZ}"/>
                <mass value="${L07_Mass}"/>
                <inertia
                    ixx="${L07_Ixx}" ixy="${L07_Ixy}" ixz="${L07_Ixz}"
                    iyy="${L07_Iyy}" iyz="${L07_Iyz}"
                    izz="${L07_Izz}"/> 
            </inertial>
        </link>

        <!-- <xacro:if value="$(arg OAKCamera)">
            <xacro:camera id="${id}" connected_to="${id}link06" xyz="${0.051+0.02} 0 ${0.05+0.03}" rpy="0 0 0"/>
        </xacro:if> -->

        <!-- <xacro:if value="$(arg FTSensor)">
            <link name="${id}ft_link">
                <visual>
                    <geometry>
                        <cylinder radius="0.025" length="0.04"/>
                    </geometry>
                    <origin xyz="0.0 0.0 0.0" rpy="0 0.0 0.0"/>
                </visual>
                <collision>
                    <geometry>
                        <cylinder radius="0.025" length="0.04"/>
                    </geometry>
                    <origin xyz="0.0 0.0 0.0" rpy="0 0.0 0.0"/>
                </collision>

                <xacro:cylinder_inertial mass="0.03" radius="0.025" length="0.04" />
            </link>

            <xacro:linkGazebo link="${id}ft_link" />

            <joint name="${id}ft_joint" type="fixed">
                <origin xyz="${0.051+0.02} 0.0 0.0" rpy="${pi/2} 0.0 ${pi/2}"/>
                <parent link="${id}link06"/>
                <child link="${id}ft_link"/>
            </joint> -->

            <!-- Enable the Joint Feedback -->
            
        <!-- </xacro:if> -->

    </xacro:macro>

</robot>