<?xml version="1.0"?>
<robot name="arm_left" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find libertech_arm_description)/urdf/const.xacro"/>
    <xacro:property name="last_arm_link" value="end_effector_link"/>

    <xacro:macro name="load_arm" params="
        prefix:='' 
        connected_to:='' 
        xyz:='0 0 0' 
        rpy:='0 0 0'
        use_hand:=false
        use_gripper:=false
        use_fake_hardware:=false
        sim_ignition:=false" >
        <xacro:unless value="${not connected_to}">
            <joint name="${connected_to}_arm_left_joint" type="fixed">
                <parent link="${connected_to}"/>
                <child link="${prefix}arm_left_base"/>
                <origin rpy="${rpy}" xyz="${xyz}"/>
            </joint>
        </xacro:unless>

        <xacro:include filename="$(find libertech_arm_description)/urdf/arm.ros2_control.xacro" />
        <xacro:arg name="initial_positions_file" default="$(find libertech_arm_description)/config/initial_positions.yaml"/>
        <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

        <xacro:arm_ros2_control
            prefix="${prefix}"
            name="arm_left" 
            use_fake_hardware="${use_fake_hardware}"
            sim_ignition="${sim_ignition}"
            initial_positions="${xacro.load_yaml(initial_positions_file)}" />
       
       <link name="${prefix}arm_left_base">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL"  scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/base_left.STL"  scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                   <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/base.STL" scale="-1 1 1"/> -->
                   <mesh filename="file://$(find libertech_arm_description)/meshes/base_left.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>   
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${-base_ComX} ${base_ComY} ${base_ComZ}"/>
                <mass value="${base_Mass}"/>
                <inertia
                    ixx="${base_Ixx}" ixy="${-base_Ixy}" ixz="${-base_Ixz}"
                    iyy="${base_Iyy}" iyz="${base_Iyz}"
                    izz="${base_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint1" type="revolute">
            <origin rpy="1.5708 0 1.5708" xyz="-0.068 0 0"/>
            <parent link="${prefix}arm_left_base"/>
            <child link="${prefix}arm_left_link01"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint1_PositionMin}" upper="${joint1_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link01">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link1_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link1.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link1_left.STL" scale="1 1 1"/>
                </geometry> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L01_ComX} ${L01_ComY} ${-L01_ComZ}"/>
                <mass value="${L01_Mass}"/>
                <inertia
                    ixx="${L01_Ixx}" ixy="${L01_Ixy}" ixz="${-L01_Ixz}"
                    iyy="${L01_Iyy}" iyz="${-L01_Iyz}"
                    izz="${L01_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint2" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0 0 0"/>
            <parent link="${prefix}arm_left_link01"/>
            <child link="${prefix}arm_left_link02"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint2_PositionMin}" upper="${joint2_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link02">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link2_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                     <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link2.STL" scale="-1 1 1"/> -->
                     <mesh filename="file://$(find libertech_arm_description)/meshes/link2_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${-L02_ComX} ${L02_ComY} ${L02_ComZ}"/>
                <mass value="${L02_Mass}"/>
                <inertia
                    ixx="${L02_Ixx}" ixy="${-L02_Ixy}" ixz="${-L02_Ixz}"
                    iyy="${L02_Iyy}" iyz="${L02_Iyz}"
                    izz="${L02_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint3" type="revolute">
            <origin rpy="1.5708 0 0" xyz="0.0405 -0.1135 0"/>
            <parent link="${prefix}arm_left_link02"/>
            <child link="${prefix}arm_left_link03"/>
            <axis xyz="0 0 -1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint3_PositionMin}" upper="${joint3_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link03">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link3.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link3_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link3.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link3_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${-L03_ComX} ${L03_ComY} ${L03_ComZ}"/>
                <mass value="${L03_Mass}"/>
                <inertia
                    ixx="${L03_Ixx}" ixy="${-L03_Ixy}" ixz="${-L03_Ixz}"
                    iyy="${L03_Iyy}" iyz="${L03_Iyz}"
                    izz="${L03_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint4" type="revolute">
            <origin rpy="-1.5708 0 1.5708" xyz="0 0.053741 0.15856"/> 
            <parent link="${prefix}arm_left_link03"/>
            <child link="${prefix}arm_left_link04"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint4_PositionMin}" upper="${joint4_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link04">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link4_left.STL"  scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link4_left.STL"  scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link4_left.STL"  scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link4_left.STL"  scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L04_ComX} ${L04_ComY} ${-L04_ComZ}"/>
                <mass value="${L04_Mass}"/>
                <inertia
                    ixx="${L04_Ixx}" ixy="${L04_Ixy}" ixz="${-L04_Ixz}"
                    iyy="${L04_Iyy}" iyz="${-L04_Iyz}"
                    izz="${L04_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint5" type="revolute">
            <origin rpy="0 1.5708 0" xyz="0.0991 0 9.4529E-05"/>
            <parent link="${prefix}arm_left_link04"/>
            <child link="${prefix}arm_left_link05"/>
            <axis xyz="0 0 -1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint5_PositionMin}" upper="${joint5_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link05">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link5_left.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link5_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link5_left.STL" scale="-1 1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link5_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${-L05_ComX} ${L05_ComY} ${L05_ComZ}"/>
                <mass value="${L05_Mass}"/>
                <inertia
                    ixx="${L05_Ixx}" ixy="${-L05_Ixy}" ixz="${-L05_Ixz}"
                    iyy="${L05_Iyy}" iyz="${L05_Iyz}"
                    izz="${L05_Izz}"/>  
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint6" type="revolute">
            <origin rpy="0 -1.5708 0" xyz="9.4529E-05 0 0.038"/>
            <parent link="${prefix}arm_left_link05"/>
            <child link="${prefix}arm_left_link06"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>

        <link name="${prefix}arm_left_link06">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link6_left.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link6_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link6_left.STL" scale="1 1 -1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link6_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L06_ComX} ${L06_ComY} ${-L06_ComZ}"/>
                <mass value="${L06_Mass}"/>
                <inertia
                    ixx="${L06_Ixx}" ixy="${L06_Ixy}" ixz="${-L06_Ixz}"
                    iyy="${L06_Iyy}" iyz="${-L06_Iyz}"
                    izz="${L06_Izz}"/> 
            </inertial>
        </link>

        <joint name="${prefix}arm_left_joint7" type="revolute">
            <origin rpy="-1.5708 0 0" xyz="0.065 0 9.4629E-05"/>
            <parent link="${prefix}arm_left_link06"/>
            <child link="${prefix}arm_left_link07"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="${jointDamping}" friction="${jointFriction}"/>
            <limit effort="${torqueMax}" velocity="${velocityMax}" lower="${joint6_PositionMin}" upper="${joint6_PositionMax}"/>
        </joint>
        
        <link name="${prefix}arm_left_link07">
             <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link7_left.STL" scale="1 -1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link7_left.STL" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.913725 0.913725 0.847059 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <!-- <mesh filename="file://$(find libertech_arm_description)/meshes/link7_left.STL" scale="1 -1 1"/> -->
                    <mesh filename="file://$(find libertech_arm_description)/meshes/link7_left.STL" scale="1 1 1"/>
                </geometry>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <origin rpy="0 0 0" xyz="${L07_ComX} ${-L07_ComY} ${L07_ComZ}"/>
                <mass value="${L07_Mass}"/>
                <inertia
                    ixx="${L07_Ixx}" ixy="${-L07_Ixy}" ixz="${L07_Ixz}"
                    iyy="${L07_Iyy}" iyz="${-L07_Iyz}"
                    izz="${L07_Izz}"/> 
            </inertial>
        </link>

        <!-- <joint name="${prefix}arm_left_rokubi_ft_joint" type="fixed">
            <origin rpy="0.0 ${PI/2} 0.0 " xyz="0.0395 0 0"/>
            <parent link="${prefix}arm_left_link07"/>
            <child link="${prefix}arm_left_rokubi_ft_link"/>
        </joint>
        <link name="${prefix}arm_left_rokubi_ft_link" >
            <visual>
                <origin
                xyz="0 0 0"
                rpy="0 0 0" />
                <geometry>
                <mesh
                    filename="file://$(find rokubimini_description)/meshes/BFT_ROKS_M8/mounting.STL" />
                </geometry>
                <material
                name="Bota_material">
                <color
                    rgba="0.89804 0.91765 0.92941 1" />
                </material>
            </visual>
        </link>

        <joint name="${prefix}arm_left_rokubi_ft_wrench_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0.032"/>
            <parent link="${prefix}arm_left_rokubi_ft_link"/>
            <child link="${prefix}arm_left_rokubi_ft_wrench_link"/>
        </joint>
        <link name="${prefix}arm_left_rokubi_ft_wrench_link">
            <visual>
                <origin
                xyz="0 0 0"
                rpy="0 0 0" />
                <geometry>
                <mesh
                    filename="package://rokubimini_description/meshes/BFT_ROKS_M8/wrench.STL" />
                </geometry>
                <material
                name="Bota_material">
                <color
                    rgba="0.6902 0.61176 0.52941 1" />
                </material>
            </visual>
        </link> -->

        <xacro:if value="${use_hand}">
            <xacro:include filename="$(find libertech_hand_description)/urdf/hand_left_macro.xacro" />

            <xacro:load_hand
                prefix="${prefix}"
                connected_to="${prefix}arm_left_link07"
                xyz="0.16725444 -0.025962 -0.0057386"
                rpy="${-PI/2} 0.0 ${-PI/2}"
                use_fake_hardware="${use_fake_hardware}"
                sim_ignition="${sim_ignition}" />
        </xacro:if>

        <xacro:if value="${not use_hand}">
            <joint name="${prefix}${connected_to}_hand_left_joint" type="fixed">
                <parent link="${prefix}arm_left_link07"/>
                <child link="${prefix}hand_left_palm"/>
                <origin rpy="${-PI/2} 0.0 ${-PI/2}" xyz="0.16725444 -0.025962 -0.0057386"/>
            </joint>

            <link name="${prefix}hand_left_palm">
                <inertial>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <mass value="0.91778"/>
                    <inertia
                        ixx="0.0018592" ixy="6.239E-05" ixz="-6.688E-05"
                        iyy="0.0015814" iyz="3.163E-05"
                        izz="0.00064901"/> 
                </inertial>
                <collision>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find libertech_arm_description)/meshes/hand_left.STL" />
                    </geometry>
                </collision>
                <visual>
                    <origin rpy="0 0 0" xyz="0 0 0"/>
                    <geometry>
                        <mesh filename="file://$(find libertech_arm_description)/meshes/hand_left.STL" />
                    </geometry>
                    <material name="hand_material">
                        <color rgba="0.913725 0.913725 0.847059 1" />
                    </material>
                </visual>
            </link>
        </xacro:if>

    </xacro:macro>

</robot>