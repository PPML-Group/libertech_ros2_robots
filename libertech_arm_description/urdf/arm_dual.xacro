<?xml version="1.0"?>
<!-- 该文件调用macro中的load_arm_right和load_arm_left来构造双臂 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- add arms names prefixes -->
    <xacro:arg name="prefix"  default="" />
    <xacro:arg name="prefix_left"  default="left_" />
    <xacro:arg name="prefix_right" default="right_" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="simulation_controllers" default="$(find libertech_arm_description)/config/ros2_controllers.yaml" />

    <!-- initial position for simulations (Mock Hardware, Ignition) -->
    <xacro:arg name="initial_positions_file" default="$(find libertech_arm_description)/config/initial_positions.yaml"/>

    <!-- convert to property to use substitution in function -->
    <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>
      
    <xacro:include filename="$(find libertech_arm_description)/urdf/macro.xacro"/>
    <xacro:include filename="$(find libertech_arm_description)/urdf/arm.ros2_control.xacro" />

    <link name="world"/>

    <link name="baseout"/>

    <joint name="base_static_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="world"/>
        <child link="baseout"/>
    </joint>

    <xacro:load_arm_left  
        prefix="$(arg prefix_left)" 
        connected_to="baseout" 
        xyz="-0.15 0 0.0" 
        rpy="0 0 0"/>

    <xacro:load_arm_right 
        prefix="$(arg prefix_right)" 
        connected_to="baseout" 
        xyz="0.15 0 0.0" 
        rpy="0 0 0"/>

    <xacro:arm_ros2_control
        name="ArmMultiInterfaceHardware" 
        use_fake_hardware="$(arg use_fake_hardware)" 
        sim_ignition="$(arg sim_ignition)" 
        initial_positions="${xacro.load_yaml(initial_positions_file)}" />

    <xacro:if value="$(arg sim_ignition)">
        <!-- Gazebo plugins -->
        <gazebo reference="world">
        </gazebo>
        <gazebo>
            <!-- <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin"> -->
            <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>$(arg simulation_controllers)</parameters>
                <controller_manager_node_name>/controller_manager</controller_manager_node_name>
            </plugin>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <!-- <render_engine>$(arg gazebo_renderer)</render_engine> -->
                <render_engine>"ogre"</render_engine>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
