<?xml version="1.0"?>
<!-- 该文件调用macro中的load_robot来构造双臂 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- add arms names prefixes -->
    <xacro:arg name="prefix"  default="" />
    <xacro:arg name="use_hand" default="false" />
    <xacro:arg name="use_gripper" default="false" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="simulation_controllers" default="$(find libertech_arm_description)/config/ros2_controllers.yaml" />
      
    <xacro:include filename="$(find libertech_arm_description)/urdf/robot_macro.xacro"/>

    <link name="world"/>

    <link name="baseout"/>

    <joint name="base_static_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="world"/>
        <child link="baseout"/>
    </joint>

    <xacro:load_robot
        prefix="$(arg prefix)" 
        connected_to="baseout" 
        xyz="0.15 0 0.0" 
        rpy="0 0 0"
        arm="arm_right"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)"
        use_fake_hardware="$(arg use_fake_hardware)" 
        sim_ignition="$(arg sim_ignition)" />

    <xacro:load_robot
        prefix="$(arg prefix)" 
        connected_to="baseout" 
        xyz="-0.15 0 0.0" 
        rpy="0 0 0"
        arm="arm_left"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)"
        use_fake_hardware="$(arg use_fake_hardware)" 
        sim_ignition="$(arg sim_ignition)" />

    <xacro:if value="$(arg sim_ignition)">
        <!-- Gazebo plugins -->
        <gazebo reference="world">
        </gazebo>
        <gazebo>
            <!-- <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin"> -->
            <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>$(arg simulation_controllers)</parameters>
                <controller_manager_node_name>/controller_manager</controller_manager_node_name>
            </plugin>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <!-- <render_engine>$(arg gazebo_renderer)</render_engine> -->
                <render_engine>"ogre"</render_engine>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
