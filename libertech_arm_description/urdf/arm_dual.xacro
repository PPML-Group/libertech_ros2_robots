<?xml version="1.0"?>
<!-- 该文件调用macro中的load_arm_right和load_arm_left来构造双臂 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
      
    <xacro:include filename="$(find libertech_arm_description)/urdf/macro.xacro"/>
    <!-- <xacro:include filename="$(find z1_description)/urdf/gazebo.xacro"/> -->

    <link name="world"/>

    <link name="baseout"/>

    <joint name="base_static_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="world"/>
        <child link="baseout"/>
    </joint>

    <!-- add arms names prefixes -->
    <xacro:arg name="arm_1" default="left_" />
    <xacro:arg name="arm_2" default="right_" />

    <xacro:load_arm_left  id="$(arg arm_1)" connected_to="baseout" xyz="-0.3 0 0.0" rpy="0 0 0"/>

    <xacro:load_arm_right id="$(arg arm_2)" connected_to="baseout" xyz="0.3 0 0.0" rpy="0 0 0" />
</robot>
