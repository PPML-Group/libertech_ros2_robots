<?xml version="1.0"?>
<!-- 该文件调用macro中的load_robot来构造双臂 -->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- add arms names prefixes -->
    <xacro:arg name="prefix"  default="" />
    <xacro:arg name="use_hand" default="false" />
    <xacro:arg name="use_gripper" default="false" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="use_camera" default="false" /> 
    <xacro:arg name="camera_width" default="640"/>
    <xacro:arg name="camera_height" default="480"/>
    <xacro:arg name="camera_fps" default="30"/>
    <xacro:arg name="simulation_controllers" default="$(find libertech_arm_description)/config/ros2_controllers.yaml" />
      
    <xacro:include filename="$(find libertech_arm_description)/urdf/arm_hand_macro.xacro"/>

    <!-- 如果取消world则为漂浮 -->
    <link name="world"/>

    <link name="$(arg prefix)baseout"/>

    <joint name="base_static_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="world"/>
        <child link="$(arg prefix)baseout"/>
    </joint>

    <xacro:load_arm_hand
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)baseout" 
        xyz="0 -0.17735 0.35582"
        rpy="1.309 0 0"
        arm="arm_right"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)" />

    <xacro:load_arm_hand
        prefix="$(arg prefix)" 
        connected_to="$(arg prefix)baseout" 
        xyz="0 0.177350 0.355816"
        rpy="-1.308997 0 0"
        arm="arm_left"
        use_hand="$(arg use_hand)"
        use_gripper="$(arg use_gripper)" />

    <xacro:if value="$(arg use_camera)">
        <link name="$(arg prefix)head_camera_zedm" />
        <joint name="$(arg prefix)head_camera_zedm_joint" type="fixed">
            <origin xyz="0.03 -0.08 0.0" rpy="${pi/2} 0 0.2" />
            <parent link="$(arg prefix)baseout" />
            <child  link="$(arg prefix)head_camera_zedm" />
        </joint>

        <link name="$(arg prefix)head_camera_zedm_optical_frame"/>
        <joint name="$(arg prefix)head_camera_zedm_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
            <parent link="$(arg prefix)head_camera_zedm"/>
            <child link="$(arg prefix)head_camera_zedm_optical_frame"/>
        </joint>

        <gazebo reference="$(arg prefix)head_camera_zedm">
            <sensor name="zedm" type="rgbd_camera">  <!-- realsense_d435 -->
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>$(arg camera_width)</width>
                        <height>$(arg camera_height)</height>
                        <format>R8G8B8</format> <!-- RGB_INT8 -->
                        
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>5</far>
                    </clip>
                    <distortion>
                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                    <lens>
                        <intrinsics>
                            <fx>554.25469</fx> <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
                            <fy>554.25469</fy>
                            <cx>320.5</cx> <!-- cx = ( width + 1 ) / 2 -->
                            <cy>240.5</cy> <!-- cy = ( height + 1 ) / 2 -->
                            <s>0</s>
                        </intrinsics>
                        <!-- These need to match the intrinsics above or
                        Ignition will default to different default values -->
                        <projection>
                            <p_fx>554.25469</p_fx>
                            <p_fy>554.25469</p_fy>
                            <p_cx>320.5</p_cx>
                            <p_cy>240.5</p_cy>
                            <tx>0</tx>
                            <ty>0</ty>
                        </projection>
                    </lens>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.07</stddev>
                    </noise>
                    <depth_camera>
                        <clip>
                        <near>0.25</near>
                        <far>5</far>
                        </clip>
                    </depth_camera>
                    <!-- <optical_frame_id>$(arg prefix)$(arg camera_name)_camera_center_optical_frame</optical_frame_id> -->
                </camera>
                <!-- <ignition_frame_id>$(arg prefix)$(arg camera_name)_camera_center_optical_frame</ignition_frame_id> -->
                <always_on>1</always_on>
                <update_rate>$(arg camera_fps)</update_rate>
                <visualize>true</visualize>
                <topic>zedm</topic>
                <enable_metrics>false</enable_metrics>
            </sensor>
        </gazebo>

    </xacro:if>

    <xacro:include filename="$(find libertech_arm_description)/urdf/arm.ros2_control.xacro" />
    <xacro:arg name="initial_positions_file_arm" default="$(find libertech_arm_description)/config/initial_positions_arm.yaml"/>
    <xacro:property name="initial_positions_file_arm" default="$(arg initial_positions_file_arm)"/>

    <xacro:arm_ros2_control
        prefix="$(arg prefix)"
        use_right="True"
        use_left="True"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        initial_positions="${xacro.load_yaml(initial_positions_file_arm)}" />

    <xacro:if value="$(arg use_hand)">
        <xacro:include filename="$(find libertech_hand_description)/urdf/hand.ros2_control.xacro" />

        <xacro:hand_ros2_control 
            prefix="$(arg prefix)"
            use_right="True"
            use_left="True"
            use_fake_hardware="$(arg use_fake_hardware)"
            sim_ignition="$(arg sim_ignition)"/>
    </xacro:if>

    <xacro:if value="$(arg sim_ignition)">
        <!-- Gazebo plugins -->
        <gazebo reference="world">
        </gazebo>
        <gazebo>
            <!-- <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin"> -->
            <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>$(arg simulation_controllers)</parameters>
                <controller_manager_node_name>/controller_manager</controller_manager_node_name>
            </plugin>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <!-- <render_engine>$(arg gazebo_renderer)</render_engine> -->
                <!-- <render_engine>"ogre"</render_engine> -->
            </plugin>
            <!-- <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
            </plugin> -->
            <plugin filename="ignition-gazebo-forcetorque-system" name="ignition::gazebo::systems::ForceTorque">
            </plugin>

        </gazebo>
    </xacro:if>
</robot>
