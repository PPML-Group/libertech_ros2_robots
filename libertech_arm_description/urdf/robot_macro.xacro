<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="load_robot" params="
    prefix:='' 
    connected_to:=''
    xyz:='0 0 0' 
    rpy:='0 0 0'
    arm:='arm_right'
    use_hand:=false
    use_gripper:=false
    use_fake_hardware:=false
    sim_ignition:=false">

    <!-- Include and load arm macro files -->
    <xacro:include filename="$(find libertech_arm_description)/urdf/${arm}_macro.xacro" />

    <!-- Load the arm -->
    <xacro:load_arm
      prefix="${prefix}"
      connected_to="${connected_to}"
      xyz="${xyz}"
      rpy="${rpy}"
      use_hand="${use_hand}"
      use_gripper="${use_gripper}"
      use_fake_hardware="${use_fake_hardware}"
      sim_ignition="${sim_ignition}" />

  </xacro:macro>

</robot>